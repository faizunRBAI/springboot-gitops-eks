<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.1</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>springboot-gitops-eks</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>springboot-gitops-eks</name>
    <description>Spring Boot service delivered to EKS via GitHub Actions, ArgoCD and Argo Rollouts</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- Web layer: serves the landing page and the JSON API -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Actuator: /actuator/health drives k8s probes, /actuator/prometheus feeds canary analysis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Micrometer Prometheus registry: WITHOUT this, /actuator/prometheus does not exist
             and Argo Rollouts canary analysis has no metrics to query. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <layers>
                        <enabled>true</enabled>
                    </layers>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
        Dependency vulnerability scanning:

        OWASP dependency-check was removed deliberately. Without an NVD API key
        it takes 10 to 40 minutes and exceeded the CI stage timeout.

        Java dependency CVEs are still caught, at a better gate:
          * Trivy scans the BUILT IMAGE in the release stage and fails on
            HIGH/CRITICAL before the image is pushed to ECR. It inspects OS
            packages and application dependencies, including the JARs inside
            the layered Spring Boot image.
          * ECR scan on push re-scans stored images, catching CVEs disclosed
            after the build.

        To reintroduce source level SCA later, either enable GitHub Dependabot
        (free on public repositories) or add the org.owasp
        dependency-check-maven plugin back together with an NVD_API_KEY secret.
    -->
</project>
